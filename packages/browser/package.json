{
  "name": "@omni/browser",
  "version": "0.0.1",
  "private": true,
  "description": "Omni browser extension - redirect new tabs to the home page, capture the current view or the full scrolling page, and block distracting sites and ads.",
  "main": "dist/background.js",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/hieudoanm/omni.git"
  },
  "bugs": {
    "url": "https://github.com/hieudoanm/omni/issues"
  },
  "homepage": "https://github.com/hieudoanm/omni",
  "author": "hieudoanm <hieumdoan@gmail.com> (https://hieudoanm.github.io)",
  "license": "GPL-3.0",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "26.12.1"
  },
  "scripts": {
    "clean": "rimraf dist && rimraf download",
    "prebuild": "pnpm run clean && pnpm run lint && pnpm run format",
    "build": "webpack --config webpack.config.ts",
    "postbuild": "make build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "format": "prettier --cache --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "@eslint/markdown": "8.0.3",
    "@types/chrome": "0.3.6",
    "@types/firefox-webext-browser": "143.0.1",
    "@types/node": "26.6.5",
    "@webpack-cli/generators": "3.0.7",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "sharp": "0.35.5",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "web-ext": "10.8.0",
    "webpack": "5.112.2",
    "webpack-cli": "7.2.3"
  },
  "keywords": [
    "omni",
    "new-tab",
    "redirect",
    "snapshot",
    "screenshot",
    "capture",
    "full-page",
    "block",
    "distraction",
    "focus",
    "ads",
    "ad-block",
    "privacy"
  ]
}
