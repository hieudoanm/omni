{
  "name": "@omni/workspace",
  "version": "0.0.1",
  "private": true,
  "description": "Omni Workspace",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "keywords": [
    "omni"
  ],
  "license": "MIT",
  "author": {
    "name": "Hieu Doan",
    "email": "hieu.doan.professional@gmail.com",
    "url": "https://hieudoanm.github.io"
  },
  "packageManager": "pnpm@12.23.0",
  "type": "module",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "ANDROID_HOME=${ANDROID_HOME:-$HOME/Library/Android/sdk} turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.13"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,md,mdx,css,scss,html,yml,yaml}": "prettier --cache --write",
    "!(vendor)/**/*.rs": "rustfmt --edition 2024"
  }
}
